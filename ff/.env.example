# Cliente (Vite las expone al navegador — solo claves públicas acá)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Modo demo: anda sin Supabase, datos en localStorage
VITE_DEMO_MODE=true

# Las claves de IA NO van acá: son secrets de la edge function.
# Vite inlinea todo lo que empiece con VITE_ en el bundle público, así que una
# clave de modelo del lado del cliente es una clave publicada.
#
#   supabase secrets set AI_PROVIDER=gemini GEMINI_API_KEY=...
#   supabase secrets set AI_DAILY_LIMIT=25
#
# Cambiar de proveedor no toca el frontend: AI_PROVIDER acepta gemini | groq |
# openai, y AI_MODEL pisa el modelo por defecto de cada uno.
#   gemini -> gemini-2.5-flash    (GEMINI_API_KEY)
#   groq   -> llama-4-scout       (GROQ_API_KEY)
#   openai -> gpt-4o-mini         (OPENAI_API_KEY)
#
# Funciones a desplegar:
#   supabase functions deploy ai-insights
#   supabase functions deploy ai-chat
